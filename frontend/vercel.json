{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "api/ping.ts", "use": "@vercel/node" },
    { "src": "api/checkout-session.ts", "use": "@vercel/node" },
    { "src": "api/clicksend/notify.ts", "use": "@vercel/node" },
    { "src": "api/twilio/verify/start.ts", "use": "@vercel/node" },
    { "src": "api/twilio/verify/check.ts", "use": "@vercel/node" },
    { "src": "api/nowpayments/invoice.ts", "use": "@vercel/node" },
    { "src": "api/nowpayments/ipn.ts", "use": "@vercel/node" },
    { "src": "api/retailcrm/order.ts", "use": "@vercel/node" },
    { "src": "api/retailcrm/payment.ts", "use": "@vercel/node" },
    { "src": "api/retailcrm/sync.ts", "use": "@vercel/node" },
    { "src": "api/webhook.ts", "use": "@vercel/node" },
    { "src": "api/[...path].ts", "use": "@vercel/node" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/ping", "dest": "/api/ping.ts" },
    { "src": "/api/checkout-session", "dest": "/api/checkout-session.ts" },
    { "src": "/api/clicksend/notify", "dest": "/api/clicksend/notify.ts" },
    { "src": "/api/twilio/verify/start", "dest": "/api/twilio/verify/start.ts" },
    { "src": "/api/twilio/verify/check", "dest": "/api/twilio/verify/check.ts" },
    { "src": "/api/nowpayments/invoice", "dest": "/api/nowpayments/invoice.ts" },
    { "src": "/api/nowpayments/ipn", "dest": "/api/nowpayments/ipn.ts" },
    { "src": "/api/retailcrm/order", "dest": "/api/retailcrm/order.ts" },
    { "src": "/api/retailcrm/payment", "dest": "/api/retailcrm/payment.ts" },
    { "src": "/api/retailcrm/sync", "dest": "/api/retailcrm/sync.ts" },
    { "src": "/api/webhook", "dest": "/api/webhook.ts" },
    { "src": "/api/(.*)", "dest": "/api/[...path].ts?path=$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
